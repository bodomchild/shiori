rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isAllowedUser() {
      return request.auth != null
        && request.auth.uid in ['8ew8WV6wdVWGDeyYet2LC4VIK3n2'];
    }

    function isValidCity(cityId) {
      return cityId in ['osaka', 'kyoto', 'kanazawa', 'kawaguchiko', 'hakone', 'tokyo'];
    }

    function hasValidMetadata(cityId, photoId) {
      return request.resource.metadata.tripId == 'japan-2026'
        && request.resource.metadata.cityId == cityId
        && request.resource.metadata.photoId == photoId
        && request.resource.metadata.uploaderUid == request.auth.uid;
    }

    function hasValidStoredMetadata(cityId, photoId) {
      return resource.metadata.tripId == 'japan-2026'
        && resource.metadata.cityId == cityId
        && resource.metadata.photoId == photoId;
    }

    match /trips/japan-2026/photos/{cityId}/{allPaths=**} {
      allow read: if isAllowedUser() && isValidCity(cityId);
    }

    match /trips/japan-2026/photos/{cityId}/{photoId}/{fileName} {
      allow create: if isAllowedUser()
        && isValidCity(cityId)
        && resource == null
        && hasValidMetadata(cityId, photoId)
        && request.resource.contentType.matches('image/.*')
        && (
          (fileName == 'original' && request.resource.size <= 30 * 1024 * 1024)
          || (fileName == 'preview.jpg'
            && request.resource.contentType == 'image/jpeg'
            && request.resource.size <= 2 * 1024 * 1024)
        );

      allow delete: if isAllowedUser()
        && isValidCity(cityId)
        && fileName in ['original', 'preview.jpg']
        && hasValidStoredMetadata(cityId, photoId);

      // Los objetos siguen siendo inmutables: nunca se sobrescriben.
      allow update: if false;
    }
  }
}
